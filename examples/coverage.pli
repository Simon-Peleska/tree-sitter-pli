%DCL DEBUG_MODE FIXED;
%DEBUG_MODE = 1;
%IF DEBUG_MODE %THEN %DO;
   %ACTIVATE DEBUG_MODE;
%END;
%ELSE %DO;
   %DEACTIVATE DEBUG_MODE;
%END;

COVERAGE: PROC OPTIONS(MAIN REORDER);
   DCL 1 REC BASED(P),
         2 A FIXED BIN(31),
         2 B CHAR(10) VARYING;
   DCL P POINTER INIT(NULL());
   DCL AREA1 AREA(1000);
   DCL COUNTER FIXED BIN(31) STATIC INTERNAL INIT(0);
   DCL AMOUNT PIC '999V99';
   DCL FLAG BIT(1) INIT('0'B);
   DCL MASK BIT(8) INIT('FF'X);
   DCL (X, Y, Z) FIXED DECIMAL(5,2) INIT(0);
   DCL VEC(1:10) FIXED BIN(31);
   DCL STR CHAR(*) VARYING;
   DCL ENTRY_VAR ENTRY(FIXED BIN(31), CHAR(20) VARYING) RETURNS(FIXED BIN(31));
   DCL OVERLAY CHAR(4) DEFINED VEC POSITION(1);

   ALLOCATE REC SET(P);

   ON ERROR BEGIN;
      PUT SKIP LIST('an error occurred');
      GOTO CLEANUP;
   END;

   ON ZERODIVIDE
      SIGNAL ERROR;

   DO X = 1 TO 10;
      IF X = 5 THEN
         ITERATE;
      IF X = 8 THEN
         LEAVE;
   END;

   COUNTER = COUNTER + 1;
   Z = (X + Y) * 2 - 1 / 3 ** 2;
   FLAG = (X > Y) & (Y ¬= Z) | ¬FLAG;
   STR = 'abc' || 'def';
   Y = SUBSTR(STR, 1, 3);

   PUT FILE(SYSPRINT) SKIP LIST(X, Y, Z);
   PUT PAGE;
   PUT EDIT((VEC(I) DO I = 1 TO 10)) (F(5));

CLEANUP:
   FREE REC;
   RETURN;
END COVERAGE;
