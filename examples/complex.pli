%INCLUDE SYSLIB(MYCOPY);

DEMO: PROCEDURE(ARGC) OPTIONS(MAIN);
   DCL ARGC FIXED BINARY(31);
   DCL 1 EMPLOYEE,
         2 NAME CHAR(30) VARYING,
         2 SALARY FIXED DECIMAL(9,2),
         2 DEPT (10) CHAR(4);
   DCL TABLE(1:10, 1:10) FLOAT DECIMAL(6) STATIC;
   DCL I FIXED BIN(31);
   DCL J FIXED BIN(31) INIT(0);
   DCL P POINTER;
   DCL BASED_VAR CHAR(10) BASED(P);
   DCL SUM FIXED DECIMAL(15,2) INIT(0);
   DCL INFILE FILE RECORD SEQUENTIAL INPUT;
   DCL SQRT_RESULT FLOAT DECIMAL(6);

   ON ENDFILE(INFILE) GOTO DONE;

   OPEN FILE(INFILE);

   DO I = 1 TO 10 BY 1 WHILE (J < 100);
      TABLE(I, I) = I * I;
      SUM = SUM + TABLE(I, I);
      IF SUM > 50 THEN
         PUT SKIP LIST('Large sum:', SUM);
      ELSE DO;
         PUT SKIP LIST('Small sum:', SUM);
         J = J + 1;
      END;
   END;

   SELECT (I);
      WHEN (1) CALL HANDLE_ONE();
      WHEN (2, 3) CALL HANDLE_TWO_OR_THREE(I, SUM);
      OTHERWISE
         PUT SKIP LIST('other');
   END;

   SQRT_RESULT = SQRT(SUM);
   EMPLOYEE.NAME = 'Jane Doe';
   EMPLOYEE.SALARY = 1234.56;
   P = ADDR(EMPLOYEE);

   READ FILE(INFILE) INTO(EMPLOYEE);

   PUT EDIT('Result:', SQRT_RESULT) (A, F(10,2));

DONE:
   CLOSE FILE(INFILE);
   RETURN;

HANDLE_ONE: PROCEDURE;
   PUT SKIP LIST('handling one');
END HANDLE_ONE;

HANDLE_TWO_OR_THREE: PROCEDURE(X, Y);
   DCL X FIXED BIN(31);
   DCL Y FIXED DECIMAL(15,2);
   PUT SKIP LIST(X, Y);
END HANDLE_TWO_OR_THREE;

END DEMO;
