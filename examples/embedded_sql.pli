DBACCESS: PROCEDURE OPTIONS(MAIN);
   DCL EMPNO FIXED BINARY(31);
   DCL EMPNAME CHAR(20) VARYING;
   DCL DEPTNO FIXED BINARY(31);

   EXEC SQL INCLUDE SQLCA;

   EXEC SQL DECLARE C1 CURSOR FOR
      SELECT EMPNO, EMPNAME FROM EMPLOYEE WHERE DEPT = :DEPTNO;

   EXEC SQL OPEN C1;

   EXEC SQL FETCH C1 INTO :EMPNO, :EMPNAME;

   IF SQLCODE ¬= 0 THEN
      GOTO DONE;

   EXEC SQL UPDATE EMPLOYEE SET SALARY = SALARY * 1.1 WHERE EMPNO = :EMPNO;

   EXEC SQL CLOSE C1;

DONE:
   EXEC SQL COMMIT;
   RETURN;
END DBACCESS;
